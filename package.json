{
  "name": "kira-rapi",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/money.test.ts tests/ledger.test.ts tests/i18n.test.ts tests/throttle.test.ts tests/audit.test.ts tests/observability.test.ts tests/approval-notify.test.ts tests/metrics.test.ts tests/config-check.test.ts",
    "test:integration": "node scripts/test-db.mjs",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:reports": ".venv/bin/python -m unittest discover -s tests/reports -v",
    "setup:reports": "bash scripts/setup-reports.sh",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "npm run db:generate && npm run db:migrate && npm run db:seed",
    "setup:local": "bash scripts/setup-local.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cleanup": "tsx scripts/cleanup.ts",
    "backup": "bash scripts/backup.sh",
    "restore:verify": "bash scripts/restore-verify.sh"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/public-sans": "5.3.0",
    "@fontsource/source-serif-4": "5.3.1",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "lucide-react": "1.55.0",
    "next": "16.4.0",
    "nodemailer": "10.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "^17.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "prettier": "^3.9.10",
    "prisma": "6.19.3",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0"
  }
}
