DATABASE_URL=postgresql://kira:CHANGE_ME@127.0.0.1:5434/kira_rapi
POSTGRES_PASSWORD=CHANGE_ME
APP_URL=http://localhost:3000
UPLOAD_DIR=.data/uploads
SEED_ADMIN_EMAIL=admin@kira-rapi.local
SEED_ADMIN_PASSWORD=CHANGE_ME_AT_LEAST_12_CHARACTERS
# Optional local demo: generates fictitious financial records only in an empty DB.
SEED_DEMO=false
# Required only when SEED_DEMO=true.
SEED_REVIEWER_PASSWORD=CHANGE_ME_AT_LEAST_12_CHARACTERS
# Development only: extra hostnames allowed to reach the dev server and to
# embed it in an iframe (e.g. a tunnel or preview proxy). Empty in production.
# DEV_PREVIEW_ORIGINS=preview.example.dev
# Login throttling reads the client address from X-Forwarded-For / X-Real-IP.
# Set to true only behind a proxy you control that sets the header; left unset,
# the header is ignored and a client cannot pick its own throttle bucket by
# forging it. The per-email limit still applies either way.
TRUST_PROXY_HEADERS=true
# Production refuses to start unless APP_URL is https, because the session
# cookie would otherwise lose its Secure flag. Loopback URLs are accepted for
# local containers. Set this only in a throwaway environment.
# ALLOW_INSECURE_HTTP=true
# Structured logs: one JSON object per line on stdout. debug | info | warn | error.
LOG_LEVEL=info
# Label attached to every log line, useful when several services share a sink.
SERVICE_NAME=kira-rapi
# Optional: POST error records as JSON to a collector, chat webhook or error
# tracker. Delivery failures are ignored and never block a request.
# ERROR_WEBHOOK_URL=https://errors.example/ingest
# Approval notifications. Reviewers are pinged when a document is submitted.
# Both channels are optional; with neither set the app simply stays quiet.
# Telegram: create a bot with @BotFather, then put the chat id of the group.
# APPROVAL_TELEGRAM_TOKEN=123456:ABC-DEF
# APPROVAL_TELEGRAM_CHAT_ID=-1001234567890
# Or any endpoint that accepts a JSON POST (Slack or Mattermost incoming hook):
# APPROVAL_WEBHOOK_URL=https://hooks.example/kira
# Email needs all three values. SMTP_URL accepts a connection URL, so the
# password can come from the environment rather than the database.
# SMTP_URL=smtps://user:CHANGE_ME@smtp.example:465
# MAIL_FROM="Kira Rapi <kira@example.my>"
# APPROVAL_EMAIL_TO=bendahari@example.my
# Prometheus metrics. Set a long random token to enable /api/metrics; without
# it the endpoint answers 404. Scrape with an Authorization: Bearer header.
# generate with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# METRICS_TOKEN=
# Set to false to disable request timing entirely (it patches the HTTP server).
# METRICS_ENABLED=true
