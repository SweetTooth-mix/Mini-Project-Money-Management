DATABASE_URL=postgresql://kira:CHANGE_ME@127.0.0.1:5434/kira_rapi
POSTGRES_PASSWORD=CHANGE_ME
APP_URL=http://localhost:3000
UPLOAD_DIR=.data/uploads
SEED_ADMIN_EMAIL=admin@kira-rapi.local
SEED_ADMIN_PASSWORD=CHANGE_ME_AT_LEAST_12_CHARACTERS
# Optional local demo: generates fictitious financial records only in an empty DB.
SEED_DEMO=false
# Required only when SEED_DEMO=true.
SEED_REVIEWER_PASSWORD=CHANGE_ME_AT_LEAST_12_CHARACTERS
# Development only: extra hostnames allowed to reach the dev server and to
# embed it in an iframe (e.g. a tunnel or preview proxy). Empty in production.
# DEV_PREVIEW_ORIGINS=preview.example.dev
# Login throttling reads the client address from X-Forwarded-For / X-Real-IP.
# Set to false only when the app is exposed to the internet without a proxy,
# otherwise a client could forge the header and avoid the per-address limit.
TRUST_PROXY_HEADERS=true
# Structured logs: one JSON object per line on stdout. debug | info | warn | error.
LOG_LEVEL=info
# Label attached to every log line, useful when several services share a sink.
SERVICE_NAME=kira-rapi
# Optional: POST error records as JSON to a collector, chat webhook or error
# tracker. Delivery failures are ignored and never block a request.
# ERROR_WEBHOOK_URL=https://errors.example/ingest
